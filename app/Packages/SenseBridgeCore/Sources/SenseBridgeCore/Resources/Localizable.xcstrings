        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách gần nhất tôi đo được là khoảng %@."
          }
        }
      }
    },
    "The nearest measured distance is further away now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest measured distance is further away now."
          }
