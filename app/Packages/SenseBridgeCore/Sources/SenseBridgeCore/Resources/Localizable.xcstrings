    "SenseBridge is back to checking at its normal pace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseBridge is back to checking at its normal pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseBridge vuelve a comprobar a su ritmo normal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SenseBridge đã trở lại tốc độ kiểm tra bình thường."
          }
        }
      }
    },
    "Sentence %1$@ of %2$@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentence %1$@ of %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frase %1$@ de %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu %1$@ trên %2$@."
          }
        }
      }
    },
    "Text runs past the bottom. Try tilting the camera down, or moving back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text runs past the bottom. Try tilting the camera down, or moving back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se sale por abajo. Prueba a inclinar la cámara hacia abajo o a alejarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản vượt quá phía dưới. Hãy thử nghiêng máy ảnh xuống hoặc đưa ra xa."
          }
        }
      }
    },
    "Text runs past the edges of the frame. Try moving the camera back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text runs past the edges of the frame. Try moving the camera back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se sale de los bordes del encuadre. Prueba a alejar la cámara."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản vượt quá các cạnh khung hình. Hãy thử đưa máy ảnh ra xa."
          }
        }
      }
    },
    "Text runs past the left. Try moving the camera left, or moving back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text runs past the left. Try moving the camera left, or moving back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se sale por la izquierda. Prueba a mover la cámara a la izquierda o a alejarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản vượt quá bên trái. Hãy thử di chuyển máy ảnh sang trái hoặc đưa ra xa."
          }
        }
      }
    },
    "Text runs past the right. Try moving the camera right, or moving back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text runs past the right. Try moving the camera right, or moving back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se sale por la derecha. Prueba a mover la cámara a la derecha o a alejarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản vượt quá bên phải. Hãy thử di chuyển máy ảnh sang phải hoặc đưa ra xa."
          }
        }
      }
    },
    "Text runs past the top. Try tilting the camera up, or moving back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text runs past the top. Try tilting the camera up, or moving back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se sale por arriba. Prueba a inclinar la cámara hacia arriba o a alejarla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản vượt quá phía trên. Hãy thử nghiêng máy ảnh lên hoặc đưa ra xa."
          }
        }
      }
    },
    "The nearest distance I could measure is about %@.": {
      "extractionState": "manual",
