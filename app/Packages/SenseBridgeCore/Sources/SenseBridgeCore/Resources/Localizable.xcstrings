        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách đo được gần nhất giờ đã xa hơn."
          }
        }
      }
    },
    "The phone is hot, so SenseBridge is checking much less often.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone is hot, so SenseBridge is checking much less often."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teléfono está muy caliente, así que SenseBridge comprueba con mucha menos frecuencia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại đang nóng, nên SenseBridge kiểm tra ít thường xuyên hơn nhiều."
          }
        }
      }
    },
    "The phone is warm, so SenseBridge is checking less often.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone is warm, so SenseBridge is checking less often."
