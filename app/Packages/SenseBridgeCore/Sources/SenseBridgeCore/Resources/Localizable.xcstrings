    "Cloud descriptions are working again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud descriptions are working again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descripciones en la nube están funcionando de nuevo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả trên đám mây đã hoạt động trở lại."
          }
        }
      }
    },
    "Cloud descriptions aren't responding, so SenseBridge is continuing with on-device descriptions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud descriptions aren't responding, so SenseBridge is continuing with on-device descriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descripciones en la nube no responden, así que SenseBridge continúa con descripciones en el dispositivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả trên đám mây không phản hồi, vì vậy SenseBridge tiếp tục dùng mô tả trên thiết bị."
          }
        }
      }
    },
    "Couldn't take a measurement. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't take a measurement. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo tomar una medición. Inténtalo de nuevo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đo được. Hãy thử lại."
          }
        }
      }
    },
    "End of the text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of the text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin del texto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hết văn bản."
          }
        }
      }
    },
    "Hands-free awareness is running again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-free awareness is running again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La percepción manos libres está funcionando de nuevo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ nhận biết rảnh tay đang chạy trở lại."
          }
        }
      }
    },
    "Hands-free awareness ran for %1$@. Alerts raised: %2$@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-free awareness ran for %1$@. Alerts raised: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La percepción manos libres funcionó durante %1$@. Avisos generados: %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ nhận biết rảnh tay đã chạy %1$@. Số cảnh báo: %2$@."
          }
        }
      }
    },
    "Hands-free awareness stopped because SenseBridge is no longer on screen. It will start again when you come back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-free awareness stopped because SenseBridge is no longer on screen. It will start again when you come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La percepción manos libres se ha detenido porque SenseBridge ya no está en pantalla. Se reanudará cuando vuelvas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ nhận biết rảnh tay đã dừng vì SenseBridge không còn hiển thị trên màn hình. Nó sẽ tiếp tục khi bạn quay lại."
          }
        }
      }
    },
    "No text is being recognized. Try moving closer, or adding light.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text is being recognized. Try moving closer, or adding light."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se está reconociendo texto. Prueba a acercarte o a añadir luz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhận ra văn bản nào. Hãy thử lại gần hơn hoặc thêm ánh sáng."
          }
        }
      }
    },
    "Nothing recognizable was found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing recognizable was found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció nada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhận ra được gì."
          }
        }
      }
    },
