    "Keeps the text you read on this device so you can hear it again. Turning this off deletes everything already saved." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the text you read on this device so you can hear it again. Turning this off deletes everything already saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda en este dispositivo el texto que lees para que puedas volver a escucharlo. Desactivarlo borra todo lo ya guardado."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ văn bản bạn đọc trên thiết bị này để bạn có thể nghe lại. Tắt tùy chọn này sẽ xóa mọi thứ đã lưu."
          }
        }
      }
    },
    "Kept on this device only, locked while the device is locked, never included in a backup, and limited to the most recent 25 documents. Turning history off deletes what is already here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept on this device only, locked while the device is locked, never included in a backup, and limited to the most recent 25 documents. Turning history off deletes what is already here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda solo en este dispositivo, bloqueado mientras el dispositivo está bloqueado, nunca incluido en una copia de seguridad, y limitado a los 25 documentos más recientes. Desactivar el historial borra lo que ya hay aquí."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ lưu trên thiết bị này, bị khóa khi thiết bị khóa, không bao giờ có trong bản sao lưu, và giới hạn ở 25 tài liệu gần nhất. Tắt lịch sử sẽ xóa những gì đang có ở đây."
          }
        }
      }
    },
