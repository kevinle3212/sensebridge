    },
    "More detail means SenseBridge names more of what it recognized, not that it is more sure about any of it. Every description is still a cautious guess, and SenseBridge still never says the way ahead is clear." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More detail means SenseBridge names more of what it recognized, not that it is more sure about any of it. Every description is still a cautious guess, and SenseBridge still never says the way ahead is clear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más detalle significa que SenseBridge nombra más de lo que reconoció, no que esté más seguro de ello. Cada descripción sigue siendo una suposición cautelosa, y SenseBridge nunca dice que el camino esté despejado."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi tiết hơn nghĩa là SenseBridge nêu tên nhiều thứ đã nhận diện hơn, chứ không phải chắc chắn hơn về điều đó. Mỗi mô tả vẫn là một phỏng đoán thận trọng, và SenseBridge không bao giờ nói rằng phía trước đã an toàn."
          }
        }
      }
    },
    "NVIDIA NIM" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NVIDIA NIM"
