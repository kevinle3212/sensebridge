    "Listens once for a recognizable sound nearby and announces what it might be." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens once for a recognizable sound nearby and announces what it might be."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha una vez en busca de un sonido reconocible cercano y anuncia qué podría ser."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lắng nghe một lần để tìm âm thanh có thể nhận biết ở gần và thông báo đó có thể là gì."
          }
        }
      }
    },
    "Live reading keeps looking and tells you how to aim. It reads a page out once the text stops changing, and turns the light on if the view is dark." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live reading keeps looking and tells you how to aim. It reads a page out once the text stops changing, and turns the light on if the view is dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lectura continua sigue mirando y te dice cómo apuntar. Lee una página cuando el texto deja de cambiar, y enciende la luz si la vista está oscura."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ đọc liên tục tiếp tục quan sát và hướng dẫn bạn cách hướng máy. Nó đọc một trang khi văn bản ngừng thay đổi, và bật đèn nếu khung hình tối."
          }
        }
      }
    },
