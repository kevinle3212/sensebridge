    "Free, private, and the default. Nothing about your surroundings leaves your device." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free, private, and the default. Nothing about your surroundings leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis, privado y la opción predeterminada. Nada sobre tu entorno sale de tu dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí, riêng tư và là lựa chọn mặc định. Không có thông tin nào về môi trường xung quanh bạn rời khỏi thiết bị."
          }
        }
      }
    },
