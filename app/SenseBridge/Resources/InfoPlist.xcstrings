{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "SenseBridge"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge uses the camera to read text and describe scenes for you. Nothing leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge usa la cámara para leerte texto y describir escenas. Nada sale de tu dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge sử dụng camera để đọc văn bản và mô tả khung cảnh cho bạn. Không có gì rời khỏi thiết bị của bạn."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge connects to your self-hosted reasoning server, if you set one up. Nothing else on your network is contacted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge se conecta a tu servidor de razonamiento autoalojado, si configuraste uno. No se contacta nada más en tu red."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge kết nối với máy chủ suy luận tự lưu trữ của bạn, nếu bạn đã thiết lập một máy chủ. Không có gì khác trên mạng của bạn bị liên hệ."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge uses the microphone to recognize nearby sounds and announce them. Nothing leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge usa el micrófono para reconocer sonidos cercanos y anunciarlos. Nada sale de tu dispositivo."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseBridge sử dụng micrô để nhận dạng các âm thanh gần đó và thông báo chúng. Không có gì rời khỏi thiết bị của bạn."
          }
        }
      }
    }
  },
  "version" : "1.0"
}