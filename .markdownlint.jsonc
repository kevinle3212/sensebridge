{
  // MD024: allow repeated heading text (e.g. "## Resolved") as long as it
  // isn't duplicated among sibling headings under the same parent.
  "MD024": { "siblings_only": true },
  // MD013: no line-length limit — prose is hand-wrapped, not machine-checked.
  "MD013": false,
  // MD025: allow more than one top-level heading per file.
  "MD025": false,
  // MD041: the first line doesn't have to be a top-level heading.
  "MD041": false,
  // MD033: allow the specific inline HTML elements this repo actually uses
  // deliberately (headshot images with layout attributes Markdown can't
  // express, <details>/<summary> collapsible sections, and <picture>/<source>
  // to serve the knowledge-graph visual's still twin under
  // prefers-reduced-motion) — everything else stays flagged.
  "MD033": {
    "allowed_elements": ["img", "details", "summary", "picture", "source"]
  }
}
