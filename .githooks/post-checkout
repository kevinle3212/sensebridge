#!/bin/sh

# Load .env first, so any tuning variables the blocks below honor come from
# the repository's own config rather than your shell profile. Parsed, not
# sourced — see scripts/env.sh.
_SENSEBRIDGE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$_SENSEBRIDGE_ROOT" ] && [ -f "$_SENSEBRIDGE_ROOT/scripts/env.sh" ]; then
    . "$_SENSEBRIDGE_ROOT/scripts/env.sh"
fi
unset _SENSEBRIDGE_ROOT

# codegraph-sync-start
# Branch switches move the tree further than a single commit does, so the same
# incremental `codegraph sync` the post-commit hook runs is worth running here
# too — see that file for why this replaced graphify's auto-rebuild block.
# Advisory and backgrounded: a checkout must never fail because an index did.
if [ -d .codegraph ] && command -v codegraph >/dev/null 2>&1; then
    _CODEGRAPH_LOG="${HOME}/.cache/codegraph-sync.log"
    mkdir -p "$(dirname "$_CODEGRAPH_LOG")" 2>/dev/null || true
    (codegraph sync . >"$_CODEGRAPH_LOG" 2>&1 || true) &
fi
# codegraph-sync-end
