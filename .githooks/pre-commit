#!/usr/bin/env bash
#
# pre-commit — dependency-free local gate before every commit.
#
# Runs, in order: secret scan of staged changes (gitleaks + ggshield, each
# advisory if not installed), the sensitive-file check
# (tools/check-sensitive-files.mjs), the skill-lock drift check
# (tools/skill-lock.mjs, hashing the canonical skill tree, review personas,
# and every harness adapter against .agents/skill-lock.json), the
# settings-hook check
# (tools/check-settings-hooks.mjs, which blocks owner-personal or
# double-registered hooks landing in the tracked .claude/settings.json), the
# BMAD skill-level check (tools/check-bmad-config.mjs, which catches an
# installer run resetting user_skill_level back to intermediate),
# Markdown lint (markdownlint-cli2, whole repo — all five node-dependent
# checks are skipped together, advisory, if node isn't installed), a
# regenerate-and-stage of the knowledge-graph visual when the commit touches
# docs/ or any graph input (tools/graph-visual.mjs), Swift
# lint/format (scripts/lint.sh, which no-ops
# until app/ exists), actionlint on staged workflow files (advisory if not
# installed; also runs blocking in CI), and — only when staged changes touch
# website/ — website/'s lint-staged (eslint/stylelint/prettier) and React
# Doctor (--staged --blocking warning), both scoped to the staged files only.
#
# Enabled by `git config core.hooksPath .githooks` — scripts/setup.sh does
# this. Bypass in an emergency with `git commit --no-verify` and say so in
# the PR.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Load .env so hook-tuning variables (GRAPHIFY_*, lint toggles) come from the
# repo's own config instead of your shell profile. See scripts/env.sh.
# shellcheck source=scripts/env.sh
. "$REPO_ROOT/scripts/env.sh"

if command -v gitleaks >/dev/null 2>&1; then
	gitleaks protect --staged --redact --config .gitleaks.toml
else
	echo "pre-commit: gitleaks not installed (brew install gitleaks) — skipping local secret scan; CI still scans." >&2
fi

if command -v ggshield >/dev/null 2>&1; then
	ggshield secret scan pre-commit
else
	echo "pre-commit: ggshield not installed (brew install ggshield; then ggshield auth login) — skipping GitGuardian scan; CI still scans." >&2
fi

if command -v node >/dev/null 2>&1; then
	node tools/check-sensitive-files.mjs
	node tools/skill-lock.mjs
	node tools/check-settings-hooks.mjs
	node tools/check-bmad-config.mjs
	npx --yes markdownlint-cli2 "**/*.md" "COMPLETED.todo"
else
	echo "pre-commit: node not installed — skipping sensitive-file check, skill-lock drift check, settings-hook check, BMAD config check, and Markdown lint; CI still scans." >&2
fi

# Keep the committed knowledge-graph visual in step with the commit being made,
# so docs never ship a picture of an older repository.
#
# Only the SVG render runs here (~1s of node). graphify-out/graph.json is
# already on disk — post-commit rebuilds it after every commit — and a full
# `graphify update .` would add up to two minutes to every commit for no gain.
# The visual therefore pictures the graph as of the previous commit, which is
# exactly what its own caption claims ("at commit <sha>").
if command -v node >/dev/null 2>&1 &&
	[ -f graphify-out/graph.json ] &&
	git diff --cached --name-only | grep -qE '^(docs/|app/|website/src/|tools/|scripts/)'; then
	# Hashed rather than `git diff`-ed: the pair can still be untracked (the
	# generator is newer than the last commit that touched docs/), and
	# `git diff` is blind to untracked files, so it would report "clean" and
	# never stage them. `git add` runs either way — staging an unchanged file
	# is a no-op — and the notice fires only when the bytes really moved.
	_graph_before=$(cat docs/assets/graph.svg docs/assets/graph-static.svg 2>/dev/null | shasum)
	node tools/graph-visual.mjs >/dev/null
	_graph_after=$(cat docs/assets/graph.svg docs/assets/graph-static.svg | shasum)
	git add docs/assets/graph.svg docs/assets/graph-static.svg
	if [ "$_graph_before" != "$_graph_after" ]; then
		echo "pre-commit: knowledge-graph visual was stale — regenerated and staged docs/assets/graph*.svg." >&2
	fi
fi

./scripts/lint.sh

if git diff --cached --name-only | grep -qE "^\.github/workflows/.*\.ya?ml$"; then
	if command -v actionlint >/dev/null 2>&1; then
		actionlint
	else
		echo "pre-commit: actionlint not installed (brew install actionlint) — skipping local workflow lint; CI still lints." >&2
	fi
fi

if git diff --cached --name-only | grep -q '^website/'; then
	if [ -d website/node_modules ]; then
		(cd website && npx lint-staged)
		# `env -u GIT_DIR` is load-bearing. Git exports GIT_DIR to every hook,
		# and React Doctor resolves its own git queries from website/ — so the
		# inherited value wins over normal discovery. In a linked worktree
		# (.claude/worktrees/*) that value is .git/worktrees/<name>, which makes
		# its index-vs-worktree config precondition resolve against the wrong
		# root and abort with "configuration differs between the index and
		# worktree", listing every gitignored node_modules/**/package.json.
		# Reproduced deterministically: setting GIT_DIR alone fails, unsetting it
		# passes. GIT_INDEX_FILE stays exported (it's harmless here) so --staged
		# still reads the exact index being committed, including the temporary
		# one `git commit --only` builds.
		(cd website && env -u GIT_DIR npx react-doctor --staged --blocking warning --no-telemetry)
	else
		echo "pre-commit: website/node_modules not installed (run 'npm install' in website/) — skipping website lint-staged and React Doctor; CI still lints/scans." >&2
	fi
fi
