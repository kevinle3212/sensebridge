#!/bin/sh

# Load .env first, so any tuning variables the blocks below honor come from
# the repository's own config rather than your shell profile. Parsed, not
# sourced — see scripts/env.sh.
_SENSEBRIDGE_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$_SENSEBRIDGE_ROOT" ] && [ -f "$_SENSEBRIDGE_ROOT/scripts/env.sh" ]; then
    . "$_SENSEBRIDGE_ROOT/scripts/env.sh"
fi
unset _SENSEBRIDGE_ROOT

# codegraph-sync-start
# Hand-maintained, and the reason it exists: graphify was retired on
# 2026-08-18 and it was the only index that refreshed itself, via a
# vendor-installed block that sat right here. Dropping it without a
# replacement would have left every index in the repository stale by default
# — GitNexus was already 14 days behind when graphify came out.
#
# `codegraph sync` is incremental (it diffs against the last index rather than
# rebuilding), which is why this one is safe to actually run from a hook where
# the GitNexus block above only prints a reminder. Backgrounded and fully
# advisory all the same: a post-commit hook must never fail a commit that has
# already been written, so every failure path here is swallowed.
if [ -d .codegraph ] && command -v codegraph >/dev/null 2>&1; then
    _CODEGRAPH_CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD 2>/dev/null)
    _CODEGRAPH_NON_INDEX=$(echo "$_CODEGRAPH_CHANGED" | grep -v '^\.codegraph/' || true)
    if [ -n "$_CODEGRAPH_NON_INDEX" ]; then
        _CODEGRAPH_LOG="${HOME}/.cache/codegraph-sync.log"
        mkdir -p "$(dirname "$_CODEGRAPH_LOG")" 2>/dev/null || true
        (codegraph sync . >"$_CODEGRAPH_LOG" 2>&1 || true) &
    fi
fi
# codegraph-sync-end
