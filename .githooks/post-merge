#!/usr/bin/env bash
#
# post-merge — dependency-free equivalent of Husky's post-merge
# ("reinstall if package.json changed"). Flags manifest/toolchain files that
# just changed via merge/pull so they surface immediately instead of as a
# mystery build failure later. Advisory only — never blocks.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Load .env so hook-tuning variables (lint toggles) come from the
# repo's own config instead of your shell profile. See scripts/env.sh.
# shellcheck source=scripts/env.sh
. "$REPO_ROOT/scripts/env.sh"

CHANGED="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || true)"
[ -z "$CHANGED" ] && exit 0

if echo "$CHANGED" | grep -qE '^(Package\.swift|Package\.resolved|app/Package\.swift|app/Package\.resolved)$'; then
	echo "post-merge: Package manifest changed — open Xcode (or run 'swift package resolve') to pick up dependency changes." >&2
fi

if echo "$CHANGED" | grep -qE '^(docs/ENVIRONMENT\.md|scripts/setup\.sh)$'; then
	echo "post-merge: toolchain/hook setup changed — re-run 'scripts/setup.sh' to pick it up." >&2
fi

# Advisory-only GitNexus staleness reminder — see .githooks/post-commit for
# the rationale (no vendor `hook install` for GitNexus; never auto-reindexes).

# Refresh website/tsconfig.debug.json's diagnostics output (.tsbuildinfo.debug,
# trace/) whenever landing on main with website source changes — deliberately
# NOT wired into pre-push, pre-commit, or any test/CI job: it's a deep,
# non-blocking diagnostics pass (see the config's own header comment), not a
# gate. Best-effort only; a failure here must never fail the merge.
if [ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] && echo "$CHANGED" | grep -qE '^website/(src/|tsconfig)'; then
	echo "post-merge: refreshing website/tsconfig.debug.json diagnostics output..." >&2
	npm --prefix website run typecheck:debug >/dev/null 2>&1 || echo "post-merge: typecheck:debug exited non-zero (expected — it's a diagnostics pass, see tsconfig.debug.json's header comment); output refreshed anyway." >&2
fi

exit 0
