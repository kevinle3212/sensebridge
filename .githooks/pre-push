#!/usr/bin/env bash
#
# pre-push — local mirror of the CI build gate before code leaves the machine.
#
# Refuses to push commits directly to refs/heads/main (branch as
# feat/fix/chore/... and open a PR, per CONTRIBUTING.md), then runs a
# build-only check using the same project-detection as .github/workflows/ci.yml
# (no-ops until app/ is scaffolded), then an OSV dependency scan mirroring
# .github/workflows/security.yml's osv-scan job. CI still runs the full
# build+test+scan; this just catches the fast, common breakage before a push.
#
# Enabled by `git config core.hooksPath .githooks` — scripts/setup.sh does
# this. Bypass in an emergency with `git push --no-verify` and say so in the
# PR.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Load .env so hook-tuning variables (GRAPHIFY_*, lint toggles) come from the
# repo's own config instead of your shell profile. See scripts/env.sh.
# shellcheck source=scripts/env.sh
. "$REPO_ROOT/scripts/env.sh"

protected_ref='refs/heads/main'
# shellcheck disable=SC2034 # names the pushed-refs stdin format for readability; only remote_ref is used
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "$protected_ref" ]; then
		echo "pre-push: refusing to push directly to main — branch as feat/fix/chore/... and open a PR (see CONTRIBUTING.md)." >&2
		exit 1
	fi
done

if compgen -G "Package.swift" >/dev/null || compgen -G "app/Package.swift" >/dev/null; then
	echo "== swift build =="
	swift build
elif compgen -G "app/*.xcodeproj" >/dev/null || compgen -G "app/*.xcworkspace" >/dev/null; then
	if [ "$(uname -s)" != Darwin ]; then
		echo "pre-push: Xcode project build requires macOS — skipping on $(uname -s); app/ is macOS-only, see docs/ENVIRONMENT.md." >&2
	else
		# Delegated rather than duplicated: scripts/app.sh build is the single
		# copy of the simulator-build invocation, and it is what ci.yml's gate
		# must stay in sync with. The macOS guard stays here because app.sh has
		# none — it is only ever run on the owner's Mac.
		#
		# The existence check is not paranoia: scripts/app.sh is currently
		# untracked (every sibling in scripts/ is committed; it alone is not),
		# so a fresh clone has this hook but no app.sh. Fail with a sentence
		# that names the cause instead of a bare "No such file or directory".
		if [ ! -x "$REPO_ROOT/scripts/app.sh" ]; then
			echo "pre-push: scripts/app.sh is missing or not executable — the build gate lives there now. If this is a fresh clone, that file is untracked and needs committing; see TODO.md." >&2
			exit 1
		fi
		echo "== xcodebuild build =="
		"$REPO_ROOT/scripts/app.sh" build
	fi
else
	echo "pre-push: no Swift package or Xcode project found under app/ yet — skipping build check."
fi

if command -v osv-scanner >/dev/null 2>&1; then
	echo "== osv-scanner (dependency vulnerabilities) =="
	# Pinned to this repo's two known lockfiles rather than `--recursive ./`.
	# The recursive directory walk's git-root/gitignore detection is unreliable
	# from inside a linked worktree (.claude/worktrees/*) — a worktree's .git is
	# a file (the gitdir pointer), not a directory, and depending on the
	# GIT_DIR git exports into every hook, the walk intermittently visits only
	# that one directory and silently reports "No package sources found"
	# instead of finding these files (`--include-git-root` alone didn't make
	# this deterministic). Explicit --lockfile paths sidestep the walker
	# entirely and were confirmed stable across repeated runs.
	osv-scanner --lockfile ./package-lock.json --lockfile ./website/package-lock.json
else
	echo "pre-push: osv-scanner not installed (brew install osv-scanner) — skipping local dependency scan; CI's osv-scan job still runs on push." >&2
fi
