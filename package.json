{
  "name": "sensebridge",
  "version": "0.0.0",
  "private": true,
  "description": "Repo-wide command center for SenseBridge \u2014 every check, lint, build, and maintenance task is an `npm run` script here. The app is Swift; the website has its own package.json under website/.",
  "license": "Apache-2.0",
  "author": "Kevin Le <https://www.linkedin.com/in/lekevin1>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinle3212/sensebridge.git"
  },
  "homepage": "https://github.com/kevinle3212/sensebridge#readme",
  "bugs": {
    "url": "https://github.com/kevinle3212/sensebridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "setup": "scripts/setup.sh",
    "copilot": "copilot",
    "verify": "npm run lint && npm run format && npm run check",
    "test": "scripts/app.sh test",
    "app:build": "scripts/app.sh build",
    "app:test": "scripts/app.sh test",
    "app:package-test": "scripts/app.sh package-test",
    "app:device": "scripts/app.sh device-build",
    "app:install": "scripts/app.sh install",
    "app:clean": "scripts/app.sh clean",
    "app:open": "scripts/open-xcode.sh",
    "lint": "npm run lint:swift && npm run lint:md && npm run lint:mjs",
    "lint:swift": "scripts/lint.sh",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"COMPLETED.todo\"",
    "lint:mjs": "eslint --config eslint.config.mjs .claude/hooks/*.mjs .claude/hooks/global/*.mjs .cursor/hooks/*.mjs tools/*.mjs",
    "lint:mjs:fix": "eslint --config eslint.config.mjs --fix .claude/hooks/*.mjs .claude/hooks/global/*.mjs .cursor/hooks/*.mjs tools/*.mjs",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"COMPLETED.todo\"",
    "lint:actions": "actionlint",
    "lint:shell": "shellcheck scripts/*.sh .githooks/* .claude/hooks/*.sh .claude/hooks/tests/*.sh .claude/hooks/global/*.sh .claude/hooks/global/tests/*.sh",
    "format": "npm run format:mjs",
    "format:fix": "npm run format:mjs:fix",
    "format:mjs": "prettier --check --config prettier.config.mjs eslint.config.mjs .claude/hooks/*.mjs .claude/hooks/global/*.mjs .cursor/hooks/*.mjs tools/*.mjs",
    "format:mjs:fix": "prettier --write --config prettier.config.mjs eslint.config.mjs .claude/hooks/*.mjs .claude/hooks/global/*.mjs .cursor/hooks/*.mjs tools/*.mjs",
    "check": "npm run check:sensitive && npm run check:skills && npm run check:hooks && npm run check:hook-tests && npm run check:bmad && npm run check:docs-js && npm run check:links && npm run check:env-loader && npm run check:graph && npm run check:linguist",
    "check:sensitive": "node tools/check-sensitive-files.mjs",
    "check:sensitive:all": "node tools/check-sensitive-files.mjs --all",
    "check:skills": "node tools/skill-lock.mjs",
    "check:hooks": "node tools/check-settings-hooks.mjs",
    "check:bmad": "node tools/check-bmad-config.mjs",
    "check:links": "scripts/check-links.sh",
    "check:docs-js": "node --check docs/assets/js/docs.js",
    "check:env-loader": "scripts/check-env-loader.sh",
    "check:graph": "node tools/graph-visual.mjs --verify",
    "check:linguist": "node tools/check-linguist-vendored.mjs",
    "check:hook-tests": "for f in .claude/hooks/tests/*.test.sh .claude/hooks/global/tests/*.test.sh; do bash \"$f\" || exit 1; done && for f in .claude/hooks/tests/*.test.mjs .claude/hooks/global/tests/*.test.mjs; do node \"$f\" || exit 1; done",
    "check:secrets": "gitleaks detect --redact --config .gitleaks.toml",
    "check:deps": "osv-scanner --lockfile ./package-lock.json --lockfile ./website/package-lock.json",
    "commitlint": "commitlint --edit",
    "docs:build": "scripts/docs.sh build",
    "docs:a11y": "scripts/docs.sh a11y",
    "design:detect": "npx --yes impeccable detect website",
    "sync:skills": "node tools/skill-lock.mjs --write",
    "todo:sweep": "node tools/sweep-done-todo.mjs",
    "todo:sweep:check": "node tools/sweep-done-todo.mjs --check",
    "todo:archive": "node tools/archive-completed-todo.mjs",
    "logs:condense": "node tools/condense-monthly-logs.mjs",
    "wiki:home": "node tools/generate-wiki-home.mjs > wiki/Home.md",
    "graph": "PYTHONHASHSEED=0 graphify update . && node tools/graph-visual.mjs",
    "graph:visual": "node tools/graph-visual.mjs",
    "website": "npm --prefix website run",
    "website:install": "npm --prefix website ci",
    "website:dev": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build",
    "website:check": "npm --prefix website run check",
    "website:container": "scripts/website-container.sh bind",
    "website:container:volume": "scripts/website-container.sh volume"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.1.0",
    "eslint": "^10.9.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  }
}
