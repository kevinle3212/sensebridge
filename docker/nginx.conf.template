# Rendered to /etc/nginx/conf.d/default.conf at container start by the base
# image's 20-envsubst-on-templates.sh entrypoint script, substituting $PORT
# from the environment. nginx's own runtime variables ($uri, $host, ...)
# aren't shell env vars, so envsubst leaves them untouched.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Astro static output: /, /es/, /vi/ each resolve to their own
    # index.html via nginx's `index` directive above.
    location / {
        try_files $uri $uri/ =404;
    }

    # Cow-in-a-hole status pages. Every registered HTTP status code now has a
    # page, generated from website/src/data/http-status.ts by
    # website/src/pages/[status].astro; 404 and 500 keep dedicated page files
    # (website/src/pages/{404,500}.astro) purely because Astro special-cases
    # those two and also builds a flat /404.html / /500.html, which is the
    # static-host error-page convention this block points at. Every other code,
    # 400 included, builds as an ordinary directory-style route
    # (/400/index.html) — verified against the actual `dist/` output, not
    # assumed. Neither 400 nor 500 is locale-routed here: a raw HTTP-level
    # error has no request path to read a locale prefix from.
    #
    # The 4xx bucket below is scoped to codes this exact server block can
    # actually emit for a pure static `try_files`, no-auth, no-rate-limit
    # server: malformed/oversized requests (400, 413, 414, 431) and a
    # disallowed method (405, e.g. POST to a static path). 401/402/406/429/451
    # etc. are deliberately left out — nothing in this config path (no auth,
    # no content negotiation, no rate limiting) can ever produce them, so
    # mapping them would be dead config for a status this server structurally
    # cannot return. Add them back the day any of that infrastructure exists.
    error_page 404 /404.html;
    error_page 400 403 405 413 414 431 /400/index.html;
    error_page 500 502 503 504 /500.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
