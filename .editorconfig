root = true

# Default: matches Prettier's baseline (2-space, LF, trimmed whitespace) so
# VS Code's indentation guides and formatOnSave never disagree with the linters.
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# MCP client configs are tab-indented by convention (matches how each tool's
# own config format ships) — pin indent_style so Prettier's formatOnSave
# doesn't silently rewrite them to spaces.
[{.mcp.json,.cursor/mcp.json,.copilot/mcp-config.json,.windsurf/mcp_config.json,.vscode/mcp.json}]
indent_style = tab

# Shell scripts and git hooks are tab-indented throughout the repo; pin it so
# the editor's indentation guides match. `tools/*.mjs`/`.claude/hooks/*.mjs`
# used to be listed here too, but they were actually space-indented in
# practice — now that prettier.config.mjs covers them (2-space, its
# default), this block is scoped to the shell files it's actually true for.
[{*.sh,.githooks/*}]
indent_style = tab
