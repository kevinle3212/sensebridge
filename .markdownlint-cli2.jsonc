{
  // Rule config lives in .markdownlint.jsonc (shared with the VS Code
  // extension, which reads that file directly). This file exists only so
  // `npx markdownlint-cli2` works from the command line and matches what
  // the editor already does — the editor's markdownlint extension honors
  // .markdownlintignore natively; this CLI version does not appear to load
  // it automatically, so the same excludes are repeated here explicitly.
  //
  // Run from the repo root: `npm run lint:md`. markdownlint-cli2 is a pinned
  // root devDependency (see package.json), installed by `npm ci` /
  // `scripts/setup.sh` — not resolved fresh via npx (see docs/TOOLING.md).
  "config": { "extends": ".markdownlint.jsonc" },
  "globs": ["**/*.md", "COMPLETED.todo"],
  "ignores": [
    "**/node_modules/**",
    "**/skills/impeccable/**",
    // Impeccable 4.0.4 (installed 2026-08-04) also writes reviewer agents
    // outside the skills tree — `.cursor/agents/` and `.github/agents/`, per
    // its own "Installed Cursor agents into: …" output. Same vendor-managed
    // status as the line above: `npx impeccable update` overwrites them, so an
    // MD033 fix here cannot survive the next update.
    "**/agents/impeccable-*.md",
    "**/agents/impeccable-*.agent.md",
    "**/skills/seo-schema/**",
    "**/skills/seo-technical/**",
    "**/skills/bmad-*/**",
    "**/skills/stripe-best-practices/**",
    "**/skills/stripe-projects/**",
    "**/skills/upgrade-stripe/**",
    "**/skills/react-doctor/**",
    "**/skills/gitnexus/**",
    "**/.impeccable/critique/**",
    ".claude/worktrees/**",
    "CLAUDE.template.md",
    "**/NOTES.local.md",
    "audits/*/[0-9]*.md",
    "graphify-out/**",
    // Paraglide JS compiler output and the inlang project it compiles from.
    // Both READMEs are written by the tooling ("Auto-generated i18n message
    // functions", "Compiled from: ./project.inlang"), are untracked, and are
    // rewritten on every build — same vendor-managed status as the impeccable
    // entries above, so a formatting fix here could not survive.
    "website/src/paraglide/**",
    "website/project.inlang/**",
    "sessions/**",
    "tmp/**",
    // Freeform subagent-driven-development artifacts (task briefs, reports,
    // review packages) — gitignored scratch, same status as sessions/**/tmp/**.
    ".superpowers/**",
    "LICENSE"
  ]
}
