# Normalize line endings; let Git decide text vs. binary per-file, override
# explicitly below for anything it can misdetect.
* text=auto eol=lf

# Source
*.swift text diff=swift
*.md    text
*.mdx   text
*.json  text
*.yml   text
*.yaml  text
*.html  text diff=html
*.css   text diff=css
*.js    text
*.sh    text eol=lf
*.toml  text

# Xcode project files are plist-format and merge conflict-prone; leave the
# default merge strategy (no auto-resolve) and just mark them generated.
*.pbxproj -text linguist-generated

# Generated / vendored — exclude from GitHub language stats and diffs.
graphify-out/** linguist-generated -diff
.gitnexus/**    linguist-generated -diff
website/package-lock.json linguist-generated -diff
package-lock.json         linguist-generated -diff

# Impeccable skill tooling — vendor-managed third-party scripts (`npx impeccable
# update` owns them), not app source. Harness parity means the same 106-file tree
# is checked in five times (.agents, .claude, .github, .gemini, .cursor), so its
# 13.5 MB of `.mjs` drowns out every real language in GitHub's stats. One glob
# covers every current and future harness copy — listing them individually is how
# three of the five got missed.
**/skills/impeccable/** linguist-vendored

# Binary — never diff or normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.ipa  binary
*.dSYM binary
*.mp3  binary
