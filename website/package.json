{
  "name": "sensebridge-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Static marketing site for SenseBridge, built with Astro (static output, zero-JS by default).",
  "license": "Apache-2.0",
  "author": "Kevin Le <https://www.linkedin.com/in/lekevin1>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinle3212/sensebridge.git",
    "directory": "website"
  },
  "homepage": "https://github.com/kevinle3212/sensebridge/tree/main/website#readme",
  "bugs": {
    "url": "https://github.com/kevinle3212/sensebridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "sync": "astro sync",
    "clean": "rm -rf dist .astro .tsbuildinfo.debug trace",
    "check": "npm run sync && npm run lint && npm run format && npm run typecheck:all && npm run build && npm run check:disclaimer && npm run check:zero-js && npm run check:site-url && npm run check:contrast && npm run check:audio && npm run check:csp && npm run check:consent && npm run check:scene-drag && npm run check:bfcache",
    "typecheck": "astro check",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "typecheck:debug": "tsc -p tsconfig.debug.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tsc",
    "trace": "npm run typecheck:debug; npm run trace:analyze",
    "trace:analyze": "analyze-trace trace --expandTypes false",
    "trace:analyze:types": "analyze-trace trace",
    "trace:types": "simplify-trace-types trace/types.json trace/types.simplified.json",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:fix": "npm run lint:css:fix && npm run lint:js:fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.scss\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate:audio": "node scripts/generate-audio.js",
    "check:audio": "node scripts/generate-audio.js --check",
    "check:disclaimer": "node scripts/check-disclaimer.js",
    "check:zero-js": "node scripts/check-zero-js.js",
    "check:csp": "node scripts/check-csp.js",
    "check:consent": "node scripts/check-consent.js",
    "check:site-url": "node scripts/check-site-url.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:scene-drag": "node scripts/check-scene-drag.js",
    "check:bfcache": "node scripts/check-bfcache.js",
    "test:a11y": "node scripts/a11y.js",
    "audit:react": "react-doctor --no-telemetry",
    "doctor": "react-doctor --no-telemetry",
    "railway:status": "node scripts/with-env.js npx --yes @railway/cli status",
    "railway:logs": "node scripts/with-env.js npx --yes @railway/cli logs -n 100",
    "railway:logs:build": "node scripts/with-env.js npx --yes @railway/cli logs --build --latest",
    "railway:redeploy": "node scripts/with-env.js npx --yes @railway/cli redeploy --from-source",
    "vercel:deploy": "node scripts/with-env.js npx --yes vercel --prod",
    "vercel:preview": "node scripts/with-env.js npx --yes vercel",
    "vercel:logs": "node scripts/with-env.js npx --yes vercel logs",
    "vercel:ls": "node scripts/with-env.js npx --yes vercel list",
    "vercel:inspect": "node scripts/with-env.js npx --yes vercel inspect --logs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@inlang/paraglide-js": "^2.25.0",
    "@sentry/astro": "^10.69.0",
    "astro": "^7.1.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.7",
    "sass": "^1.101.7",
    "three": "0.182.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.182.0",
    "@typescript/analyze-trace": "^0.11.1",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "lint-staged": "^17.2.0",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react-doctor": "^0.9.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,astro}": "eslint --fix",
    "**/*.scss": "stylelint --fix",
    "**/*.{js,ts,tsx,jsx,scss,json,md}": "prettier --write"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "puppeteer@24.43.1": true
  }
}
