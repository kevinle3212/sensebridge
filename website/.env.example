# Copy to `.env` (git-ignored) and edit. Every value below is optional: with
# an empty `.env`, or none at all, the site builds, serves, and passes its
# checks — the defaults are local and self-contained. Nothing here points at
# anyone else's hosting account.
#
# This file is read automatically by every npm script here — `build`, `dev`,
# `preview`, the `check:*` gates, `generate:audio`, and the `railway:*` /
# `vercel:*` wrappers — via scripts/load-env.js. Nothing to pass, nothing to
# remember. The repo root's `.env` is read first for shared values (see
# ../.env.example); anything set here wins, and anything already exported in
# your shell or in CI wins over both.

# Absolute origin of *your* deployment. Astro needs it for canonical URLs,
# sitemap entries, robots.txt, and OG/Twitter meta.
#
# The official SenseBridge site is https://sensebridge.vercel.app — that is
# where the project publishes, and it is the value the maintainers set on
# their own hosting. It is deliberately not the default here: a fork that
# inherited it would advertise the official site as its own canonical home.
#
# Leave it unset and the build falls back to `http://localhost:4321`, which is
# correct for local work and CI. Set it only when you deploy somewhere real —
# either here, or (better) as an environment variable in your own host's
# project settings, so the value never lands in the repository. No trailing
# slash.
#
#   SITE_URL=https://your-site.example.com
SITE_URL=

# Only needed locally to run `npm run generate:audio` — never deployed, and
# never read by the site itself (there is no backend). See README.md's
# "Natural voice narration (ElevenLabs)" section.
#
# Get a key at https://elevenlabs.io/app/settings/api-keys. Scope it to
# text-to-speech only — the script needs nothing else.
ELEVENLABS_API_KEY=

# Optional overrides; both already match the script's defaults, so leaving
# them commented out changes nothing. The voice is "Janet", approved by the
# owner on 2026-07-25 as the site's canonical narration voice — changing it
# needs a fresh listen-through, not just an edit here. `eleven_turbo_v2_5` is
# a good latency/cost/quality balance.
ELEVENLABS_VOICE_ID=eLDc7xhWxG2FElT3kUTj
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Only needed if you want the `railway:*` / `vercel:*` npm scripts to work
# without an interactive `railway login` / `vercel login` first — useful on a
# machine where you would rather not hold a browser session. Each acts on
# whichever project *your* token owns; neither can reach this project's.
#
# Left commented rather than blank on purpose: an empty value is still a *set*
# variable, and each CLI would take it as an invalid token instead of falling
# back to your logged-in session.
#
#   RAILWAY_TOKEN=...  # https://railway.com/account/tokens
#   VERCEL_TOKEN=...   # https://vercel.com/account/settings/tokens

# --- Sentry error reporting (optional; off unless PUBLIC_SENTRY_DSN is set) ---
#
# Leave PUBLIC_SENTRY_DSN unset and the Sentry SDK is not added to the bundle at
# all — not merely disabled at runtime. That is the default, and it keeps a
# fresh clone at the site's zero-JS-by-default baseline. See astro.config.mjs.
#
# Setting it does not by itself collect anything. Even with a DSN, the SDK is
# only fetched once a visitor opts in on /privacy — see
# src/scripts/monitoring-consent.ts. This variable decides whether that choice
# is *offered*; the visitor decides whether it is taken. Setting it also makes
# the consent switch render, so `npm run check:consent` can exercise it.
#
# A DSN is *not* a secret: it is a write-only ingest endpoint, it is visible in
# the shipped bundle by design, and it cannot be used to read your Sentry data.
# It still lives here rather than in the source so a fork reports to its own
# project instead of this one's.
#
#   PUBLIC_SENTRY_DSN=https://<key>@<org-id>.ingest.us.sentry.io/<project-id>
PUBLIC_SENTRY_DSN=

# Tags events so a real deployment's errors are not mixed in with a developer's.
# Defaults to "development" when unset. Set it to "production" in your host's
# project settings, alongside SITE_URL.
PUBLIC_SENTRY_ENVIRONMENT=

# Only needed to upload source maps so stack traces are readable instead of
# minified. Unlike the DSN, this IS a credential — it is write-scoped to your
# Sentry org. Never commit it, never prefix it with PUBLIC_ (that would ship it
# to every visitor), and prefer setting it in your host's environment settings
# or CI secret store over this file.
#
# Create one at https://sentry.io/settings/account/api/auth-tokens/ with the
# minimum scopes for uploading: `project:releases` and `org:read`.
#
# With it unset, the build still succeeds and errors are still reported — the
# stack traces are just minified. All three are needed together for upload.
#
#   SENTRY_AUTH_TOKEN=...
#   SENTRY_ORG=your-org-slug
#   SENTRY_PROJECT=your-project-slug
