---
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageLoader from "../components/PageLoader.astro";
import StructuredData from "../components/StructuredData.tsx";
import { m } from "../paraglide/messages.js";
import { locales, type Locale } from "../paraglide/runtime.js";
import "../styles/global/index.scss";

interface Props {
  title?: string;
  description?: string;
  /**
   * Keeps the page out of search indexes. Set by the HTTP status pages: there
   * are ~60 of them and none is a destination anyone should arrive at from a
   * search result. They are also excluded from sitemap.xml (see
   * astro.config.mjs).
   */
  noindex?: boolean;
  /**
   * Mounts the decorative "First Light" ambient 3D scene behind the page.
   * Defaults to `true`. The HTTP status/error pages set it `false`: an error
   * page is reached by accident, often on a bad connection, and the ambient
   * scene pulls the ~698kB three.js bundle when motion is allowed — not worth
   * it for a page nobody chose to visit. (It is already lazy and gated by
   * quality-gate.ts, so this only trims the motion-enabled-good-device case.)
   */
  ambient?: boolean;
  /**
   * Plays the "Span the gap" page-load sequence (PageLoader.astro). Defaults
   * to `true`. The HTTP status/error pages set it `false`: the sequence covers
   * the page for up to ~2s to make an *arrival* feel composed, and nobody
   * arrives at a status page on purpose. Someone who just hit a dead link
   * wants the explanation and the way back immediately, not a bridge building
   * itself over the message first — and an error is disproportionately likely
   * to be reached on a bad connection, where the sequence costs the most.
   *
   * Gated here rather than inside page-load.js so a status page ships neither
   * the bootstrap nor the overlay markup at all: `output: "static"` resolves
   * this at build time, so the opt-out costs a visitor zero bytes rather than
   * one early return.
   */
  pageLoader?: boolean;
}

const locale = (Astro.currentLocale ?? "en") as Locale;

const {
  title = m.meta_title({}, { locale }),
  description = m.meta_description({}, { locale }),
  noindex = false,
  ambient = true,
  pageLoader = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/*
      SVG first for browsers that take it — it is the adaptive master and stays
      sharp at any size. `favicon.ico` is the fallback for the ones that do not,
      and is requested from the site root whether it is declared or not, so
      declaring it costs nothing and shipping it stops a 404 in every log.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SenseBridge" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={getRelativeLocaleUrl(loc, "/")} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl("en", "/")} />
    {/* schema.org JSON-LD. A React component with no `client:*` directive, so
        Astro renders it to static HTML at build time and ships zero JS. */}
    <StructuredData
      siteUrl={canonicalURL.origin}
      pageUrl={canonicalURL.href}
      name="SenseBridge"
      description={description}
      locale={locale}
      repositoryUrl="https://github.com/kevinle3212/sensebridge"
    />
    <link
      rel="preload"
      href="/fonts/fraunces-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline src="/theme-init.js"></script>
    {/* Bootstrap for the "Span the gap" page-load sequence (PageLoader.astro).
        Blocking, in <head>, and before the body exists, because the overlay
        must be covering the page on the first painted frame — a deferred
        script would show the finished page and then cover it. Sets one
        attribute; the driver (scripts/page-loader.ts) does the rest.
        Omitted entirely when `pageLoader` is false; see the prop's doc. */}
    {pageLoader && <script is:inline src="/page-load.js" />}
    {
      // react-scan (React render profiler) — gated on the frontmatter-level
      // import.meta.env.DEV check, not inside the script body: since
      // output: "static" prerenders this once at build time, the `false`
      // branch means the <script> tag itself never appears in the built
      // HTML, so zero bytes of it ship to a production visitor.
      import.meta.env.DEV && (
        <script>
          import { scan } from "react-scan";

          scan({ enabled: true });
        </script>
      )
    }
  </head>
  <body>
    <!-- "First Light" ambient 3D scene (scripts/scenes/ambient.ts): sits behind
         every page's content (see _base.scss's .ambient-scene). Decorative
         only, and only ever mounted once webglAllowed() (quality-gate.ts)
         passes — the site's complete design with this absent is the static
         CSS/SVG background it already has. -->
    {ambient && <div class="ambient-scene" data-scene="ambient" aria-hidden="true"></div>}
    <a class="skip-link" href="#main">{m.layout_skip_link({}, { locale })}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Last in the body on purpose. It is decorative and aria-hidden, so it
        must not sit ahead of the skip link, the header, or the main content in
        reading order; it paints over them via z-index instead. */}
    {pageLoader && <PageLoader />}
    <script>
      // Driver for the page-load sequence. Deliberately not deferred to idle
      // like the two loaders below: those decorate a page the visitor can
      // already use, whereas this one is currently covering it, so every ms it
      // waits is a ms the page stays hidden. It is dependency-free and small
      // for exactly that reason.
      //
      // Left unconditional while the overlay above is gated: Astro hoists and
      // bundles a non-inline <script> per page whether or not the expression
      // wrapping it renders, so gating it here would be a lie in the source
      // that the build ignores. The module is a no-op without an overlay
      // anyway, since it returns early unless it finds both
      // `[data-page-loader]` and `data-page-load="building"`.
      import "../scripts/page-loader";
    </script>
    <script>
      // Motion is decoration, so its bundle (GSAP + ScrollTrigger + Lenis)
      // stays out of the critical path: load after `load`, at idle, and only
      // when the reduced-motion gate would let it run at all — a
      // reduced-motion visitor never downloads it. (If the OS preference
      // flips mid-session, from reduce to no-preference, motion stays off
      // until reload; the reverse flip is handled live by gsap.matchMedia
      // inside the module.)
      const startMotion = () => {
        if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          return;
        }
        // The `timeout` is load-bearing, not a nicety. `requestIdleCallback`
        // is best-effort: a browser that never reaches idle may never call
        // back at all, and headless Chrome demonstrably never does — which is
        // why `check:scene-drag` and `check:bfcache` could not pass, and why
        // TODO.md recorded them as "flaky under machine load" rather than as
        // structurally unable to run. The timeout turns it into a deadline, so
        // decoration starts within 2s even on a page that stays busy.
        const idle =
          window.requestIdleCallback ??
          ((callback: IdleRequestCallback) => setTimeout(callback, 1));
        idle(
          () => {
            void import("../scripts/motion");
          },
          { timeout: 2000 },
        );
      };

      // See the scenes loader below for why `readyState` is checked before
      // listening: this is a deferred module, so `load` may already be gone by
      // the time it runs, and a listener added then never fires.
      if (document.readyState === "complete") {
        startMotion();
      } else {
        window.addEventListener("load", startMotion, { once: true });
      }
    </script>
    <script>
      // "First Light" 3D scenes (scripts/scenes/index.ts) are decoration on
      // top of decoration: same after-load, at-idle, reduced-motion gate as
      // the motion loader above, so a reduced-motion visitor never even
      // fetches this tiny entry chunk. scenes/index.ts's own webglAllowed()
      // re-checks reduced-motion (plus WebGL2/saveData/deviceMemory) before it
      // ever imports `three` itself.
      const startScenes = () => {
        if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          return;
        }
        // The `timeout` is load-bearing, not a nicety. `requestIdleCallback`
        // is best-effort: a browser that never reaches idle may never call
        // back at all, and headless Chrome demonstrably never does — which is
        // why `check:scene-drag` and `check:bfcache` could not pass, and why
        // TODO.md recorded them as "flaky under machine load" rather than as
        // structurally unable to run. The timeout turns it into a deadline, so
        // decoration starts within 2s even on a page that stays busy.
        const idle =
          window.requestIdleCallback ??
          ((callback: IdleRequestCallback) => setTimeout(callback, 1));
        idle(
          () => {
            void import("../scripts/scenes/index");
          },
          { timeout: 2000 },
        );
      };

      // `readyState` is checked before listening, and that check is the whole
      // fix. Astro emits this as a module script, so it is deferred — and a
      // deferred module can execute *after* `load` has already fired, at which
      // point `addEventListener("load", …)` waits for an event that will never
      // come again. Every scene then silently fails to mount: no error, no
      // canvas, just a static page. It is a race, so it looked like
      // flakiness — `check:scene-drag` and `check:bfcache` were logged in
      // TODO.md as "flaky under machine load", which is exactly the condition
      // that makes the module land late and lose the race every time.
      if (document.readyState === "complete") {
        startScenes();
      } else {
        window.addEventListener("load", startScenes, { once: true });
      }
    </script>
    <script>
      // Pauses looping decorative CSS animations while their section is offscreen
      // (scripts/idle-anims.ts) — same load-after-`load`, at-idle, reduced-motion
      // gate as the two loaders above. Under `reduce` those animations never run,
      // so this is never fetched.
      window.addEventListener(
        "load",
        () => {
          if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
            return;
          }
          const idle =
            window.requestIdleCallback ??
            ((callback: IdleRequestCallback) => setTimeout(callback, 1));
          idle(() => {
            void import("../scripts/idle-anims");
          });
        },
        { once: true },
      );
    </script>
  </body>
</html>
