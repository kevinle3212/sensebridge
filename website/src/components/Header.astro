---
/**
 * Sticky site header: logo, primary nav, language switcher, theme toggle,
 * and a scroll-progress bar. The theme toggle's behavior is wired up by
 * the inline <script> below, kept outside the reduced-motion-gated motion
 * bundle so it works before that bundle loads.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { m } from "../paraglide/messages.js";
import { locales, type Locale } from "../paraglide/runtime.js";
import { localeNames } from "../i18n/locale-names";

const locale = (Astro.currentLocale ?? "en") as Locale;

// The three section links are rooted at this locale's home page rather than
// written as bare `#features`-style fragments. The header is shared by every
// page, but those sections only exist on the home page — from any of the ~195
// HTTP status pages a bare fragment resolves to nothing, which strands
// keyboard and screen-reader users on a link that silently does nothing (and
// which pa11y flags as an error). Prefixing with the home URL makes the link
// navigate home and scroll to the section from a status page, while staying an
// ordinary same-document fragment jump when already on the home page.
const home = getRelativeLocaleUrl(locale, "/");

type ThemeMode = "system" | "light" | "dark";

// Translated mode names, passed as the `current`/`next` params to
// `header_theme_toggle_aria_label` below rather than the raw enum values —
// the sentence must read in the visitor's language, not leak "dark"/"system".
const themeModeName: Record<ThemeMode, string> = {
  system: m.header_theme_toggle_mode_system({}, { locale }),
  light: m.header_theme_toggle_mode_light({}, { locale }),
  dark: m.header_theme_toggle_mode_dark({}, { locale }),
};

// Whether this page *is* the home page, so the wordmark link below can say so
// with aria-current. Compared with trailing slashes stripped from both sides:
// `getRelativeLocaleUrl` returns "/" and "/es/", and the request path may or
// may not carry the trailing slash depending on how the URL was reached, so a
// bare `===` would silently never match for some locales.
const isHome = Astro.url.pathname.replace(/\/$/, "") === home.replace(/\/$/, "");
---

<header class="site-header">
  <div class="wrap">
    <!-- Wordmark doubles as the home link, the convention every visitor
         already expects from a site header. Points at this locale's home
         (not a bare "/") so a Spanish or Vietnamese visitor stays in their
         language instead of being dropped onto the English page. On the home
         page itself it stays a link (removing it would move focus order
         between pages) but is marked aria-current="page", so a screen-reader
         user is told it leads nowhere new instead of having to follow it to
         find out. No matching visual state: unlike the language switcher's
         options, this link has no siblings it must be distinguished from. -->
    <a class="logo" href={home} aria-current={isHome ? "page" : undefined}>SenseBridge</a>
    <nav aria-label="Primary">
      <a href={`${home}#features`}>{m.header_nav_features()}</a>
      <a href={`${home}#privacy`}>{m.header_nav_privacy()}</a>
      <a href={`${home}#accessibility`}>{m.header_nav_accessibility()}</a>
      <a href="https://github.com/kevinle3212/sensebridge">{m.header_nav_github()}</a>
    </nav>
    <!-- Language switcher: a native <details>/<summary> dropdown — no JS
         needed for the core open/close, keyboard operation (Tab to focus,
         Enter/Space to toggle), or screen-reader support (<summary> carries
         an implicit button role with aria-expanded reflecting the open
         state for free). The always-loaded script below only layers on
         click-outside/Escape-to-close as progressive enhancement. Current
         locale is still marked aria-current="page" on its link so it isn't
         a color-only signal. Reveal animation is CSS-only via
         @starting-style, motion-safe-gated — see the style block — so it
         degrades to an instant show under prefers-reduced-motion or in
         engines that don't support @starting-style yet. -->
    <details class="language-switcher" data-lang-switcher>
      <summary aria-label={`${m.header_language_switcher_label()}: ${localeNames[locale]}`}>
        <span>{localeNames[locale]}</span>
        <svg
          class="language-switcher-caret"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M6 9l6 6 6-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </summary>
      <ul class="language-switcher-menu">
        {
          locales.map((loc) => (
            <li>
              <a
                href={getRelativeLocaleUrl(loc, "/")}
                aria-current={loc === locale ? "page" : undefined}
              >
                {localeNames[loc]}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <!-- Theme toggle: deliberately outside the reduced-motion-gated motion
           bundle (src/scripts/motion.ts) — its own always-loaded script below
           so it works with reduced-motion and before the deferred motion
           bundle ever loads. Cycles Light -> Dark -> System; the no-flash
           script in BaseLayout.astro sets the initial data-theme before first
           paint, this script only ever updates it on user activation. -->
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label={m.header_theme_toggle_aria_label(
        { current: themeModeName.dark, next: themeModeName.system },
        { locale },
      )}
    >
      <svg
        class="theme-toggle-icon"
        data-icon="light"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <line x1="12" y1="2" x2="12" y2="4"></line>
        <line x1="12" y1="20" x2="12" y2="22"></line>
        <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line>
        <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line>
        <line x1="2" y1="12" x2="4" y2="12"></line>
        <line x1="20" y1="12" x2="22" y2="12"></line>
        <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line>
        <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line>
      </svg>
      <svg
        class="theme-toggle-icon"
        data-icon="dark"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
      </svg>
      <svg
        class="theme-toggle-icon"
        data-icon="system"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
  </div>
  <!-- Page-scroll progress (Signal Blue: meaning-carrying, per the
       Two-Accent Rule). Resting/no-JS/reduced-motion state is width 0 (i.e.
       absent) — src/scripts/motion.ts → initScrollProgress() is the only
       thing that ever gives it width, scrubbed to scroll position. -->
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
</header>

<script>
  import { m } from "../paraglide/messages.js";

  // Stays on `localStorage`, unlike the site's other client storage (see
  // idb-store.ts) — `public/theme-init.js` reads this key synchronously,
  // before first paint, to avoid a flash of the wrong theme, and IndexedDB has
  // no synchronous main-thread read. See TODO.md's "Add localStorage
  // migration to databases" entry.
  const STORAGE_KEY = "sb-theme";
  type Mode = "system" | "light" | "dark";
  const NEXT_MODE: Record<Mode, Mode> = { system: "light", light: "dark", dark: "system" };
  // Paraglide's `url` strategy resolves the active locale from the page's own
  // URL in the browser, the same way Astro's own routing already did — no
  // explicit locale plumbing needed here, unlike the server-rendered
  // frontmatter above (see src/middleware.ts).
  const modeName: Record<Mode, string> = {
    system: m.header_theme_toggle_mode_system(),
    light: m.header_theme_toggle_mode_light(),
    dark: m.header_theme_toggle_mode_dark(),
  };

  // Reads the persisted theme mode. A true first visit (nothing ever
  // stored) defaults to "dark" — DESIGN.md's "dark (default), light, and
  // system" — not the OS preference; an explicit "system" choice is stored
  // as the literal string "system" (see applyMode below) and still
  // resolves via matchMedia in resolveTheme().
  function storedMode(): Mode {
    const stored = localStorage.getItem(STORAGE_KEY);
    return stored === "light" || stored === "dark" || stored === "system" ? stored : "dark";
  }

  // Resolves "system" mode to the OS-preferred light/dark scheme.
  function resolveTheme(mode: Mode): "light" | "dark" {
    if (mode === "light" || mode === "dark") {
      return mode;
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  // Updates the toggle button's aria-label and visible icon to match the current mode.
  function updateButton(button: HTMLButtonElement, mode: Mode): void {
    button.setAttribute(
      "aria-label",
      m.header_theme_toggle_aria_label({
        current: modeName[mode],
        next: modeName[NEXT_MODE[mode]],
      }),
    );
    button.querySelectorAll<SVGElement>("[data-icon]").forEach((icon) => {
      icon.style.display = icon.dataset.icon === mode ? "block" : "none";
    });
  }

  // Persists the mode explicitly (including "system", so it stays
  // distinguishable from a never-visited default) and applies the resolved
  // theme to the document.
  function applyMode(mode: Mode): void {
    localStorage.setItem(STORAGE_KEY, mode);
    document.documentElement.dataset.theme = resolveTheme(mode);
  }

  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (button) {
    updateButton(button, storedMode());
    button.addEventListener("click", () => {
      const next = NEXT_MODE[storedMode()];
      applyMode(next);
      updateButton(button, next);
    });
  }

  // Language switcher: progressive enhancement on top of the native
  // <details>/<summary> above — closes on Escape (returning focus to the
  // trigger) or on a click outside the widget, matching common dropdown
  // conventions. Core functionality (open/close, keyboard reach) works
  // identically with this script absent.
  document.querySelectorAll<HTMLDetailsElement>("[data-lang-switcher]").forEach((details) => {
    details.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        details.open = false;
        details.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (details.open && !details.contains(event.target as Node)) {
        details.open = false;
      }
    });
  });
</script>

<style lang="scss">
  @use "@styles/abstracts" as *;

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color("bg");
    border-bottom: 1px solid color("hairline");

    @include theme-transition;
  }

  .site-header .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: space("1") space("2");
    padding-block: space("2");
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: space("2");
  }

  // Below ~544px neither nav fits beside logo + toggle, and the 4-item
  // primary nav and 3-item language switcher (longer still once localized —
  // e.g. Spanish "Accesibilidad", Vietnamese "Quyền riêng tư") can't share a
  // row without wrapping mid-item, so each gets its own full-width row below
  // logo + toggle: three rows total, toggle staying up beside the logo
  // instead of dropping with the navs.
  @media (width < 34rem) {
    nav[aria-label="Primary"],
    .language-switcher {
      order: 3;
      flex-basis: 100%;
    }
  }

  nav a {
    padding-block: 0.75rem;
  }

  // Current language: aria-current="page" (set in frontmatter above) carries
  // the non-visual signal; this is the matching visual one, so the active
  // language isn't only distinguishable to assistive tech.
  .language-switcher-menu a[aria-current="page"] {
    font-weight: 700;
  }

  .language-switcher {
    position: relative;
  }

  // Trigger shares the theme toggle's shape exactly — same 44px height, same
  // hairline border, radius, and hover surface — because the two sit side by
  // side and are the header's only two controls; a bare text trigger beside a
  // bordered button read as two unrelated things. Also removes the browser's
  // default disclosure triangle so the custom caret SVG (rotated open/closed
  // below) is the only marker.
  .language-switcher summary {
    display: inline-flex;
    align-items: center;
    gap: space("1");
    min-height: 44px;
    padding-inline: space("1");
    list-style: none;
    background: transparent;
    border: 1px solid color("hairline");
    border-radius: radius("md");
    color: color("text-primary");
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background: color("surface");
    }

    @include theme-transition;
  }

  // Open trigger keeps the hover surface so the control stays visibly active
  // while its menu is on screen, rather than snapping back to transparent the
  // moment the pointer moves down into the list.
  .language-switcher[open] summary {
    background: color("surface");
  }

  .language-switcher-caret {
    width: 12px;
    height: 12px;

    @include motion-safe {
      transition: transform duration("fast") ease("standard");
    }
  }

  .language-switcher[open] .language-switcher-caret {
    transform: rotate(180deg);
  }

  // Sized to its content rather than a fixed 10rem block, floored at the
  // trigger's own width so it never reads narrower than the control it hangs
  // from, and offset by one space step so it reads as a menu belonging to the
  // trigger instead of a slab welded to it. Start-aligned (not end-): the
  // <details> is a content-width flex item on desktop but stretches full-width
  // in the <34rem three-row layout, where end-alignment would strand the menu
  // at the far edge, away from its own summary.
  .language-switcher-menu {
    position: absolute;
    inset-inline-start: 0;
    top: calc(100% + #{space("1")});
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: space("1");
    list-style: none;
    background: color("bg-elevated");
    border: 1px solid color("hairline");
    border-radius: radius("md");
    box-shadow: shadow("card");

    // Native-<details> reveal: opacity/transform-only, so it never fights
    // the browser's own display:none <-> block toggle. @starting-style is
    // the platform-native way to animate that appearance — unsupported
    // engines and prefers-reduced-motion visitors simply get an instant
    // show, which is the correct fallback per this site's motion doctrine.
    @include motion-safe {
      transition:
        opacity duration("fast") ease("standard"),
        transform duration("fast") ease("standard");

      @starting-style {
        opacity: 0;
        transform: translateY(-4px);
      }
    }

    li {
      display: block;
    }

    // Rows, not text: a 44px minimum keeps every option a comfortable pointer
    // and touch target, and nowrap stops longer localized names ("Tiếng
    // Việt") from wrapping to two lines and making the menu ragged. The
    // global drawn-in underline (styles/global/_base.scss → a:not([class]))
    // is switched off here — these rows already signal hover with a filled
    // background, and running both at once was the doubled, busy affordance.
    a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-inline: space("1");
      border-radius: radius("sm");
      background-image: none;
      white-space: nowrap;

      // Menu rows, not prose links: the resting underline that keeps an inline
      // link recognizable only makes a vertical list of three look like three
      // stacked links in a box. These are unambiguously interactive from their
      // position in the menu, and each row already fills on hover; the current
      // language stays marked by aria-current plus its bold weight below.
      text-decoration: none;

      @include motion-safe {
        transition: background-color duration("fast") ease("standard");
      }

      &:hover {
        background-color: color("surface");
      }
    }
  }

  // The wordmark is a link, but it should still read as a wordmark: inherit the
  // body color and drop the underline rather than rendering as a stray blue
  // link. It carries a class, so the drawn-in hover underline that global
  // `a:not([class])` applies to plain links never matches it.
  .logo {
    margin-inline-end: auto;
    font-weight: 700;
    color: color("text-primary");
    text-decoration: none;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid color("hairline");
    border-radius: radius("md");
    color: color("text-primary");
    cursor: pointer;

    &:hover {
      background: color("surface");
    }

    @include theme-transition;
  }

  // Default (no-JS/pre-hydration) state shows the "dark" glyph, matching
  // the default unset-localStorage mode; the toggle's own script (above)
  // corrects this to the stored mode via inline `display` once it runs.
  .theme-toggle-icon {
    display: none;
    width: 18px;
    height: 18px;

    &[data-icon="dark"] {
      display: block;
    }

    @include motion-safe {
      transition: transform duration("fast") ease("standard");
    }
  }

  // Press feedback on whichever icon is showing, plus a subtle hover rotate
  // on the sun glyph only (the interaction doesn't read naturally on the
  // other two).
  .theme-toggle:active .theme-toggle-icon {
    transform: scale(0.85);
  }

  .theme-toggle:hover .theme-toggle-icon[data-icon="light"] {
    transform: rotate(15deg);
  }

  .scroll-progress {
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    pointer-events: none;
    background: color("accent-primary");
  }
</style>
