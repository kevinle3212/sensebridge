---
// Renders the site's two "listen to this page" controls (device TTS and
// natural-audio playback) plus a status region for progressive-enhancement
// feedback. Both buttons stay `hidden` until src/scripts/read-aloud.ts
// confirms each is usable — see that file for the full
// progressive-enhancement contract. Same element IDs as the pre-Astro
// js/read-aloud.js markup so the ported script's querySelectors keep working
// unchanged.
//
// Keep this comment inside the frontmatter fence: Astro requires `---` to be
// the first thing in the file, so a JSDoc block above it silently turns the
// whole frontmatter into markup.
import { hasNaturalVoice } from "../data/natural-voice";
import { useTranslations, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = useTranslations(locale);

// Checked at build time, rather than always rendering the src and letting
// src/scripts/read-aloud.ts discover a 404 via the <audio> element's error
// event, so a real user's browser never issues a guaranteed-to-fail request
// for a file that provably doesn't exist yet — the control is simply omitted
// until the narration ships. Footer.astro gates the required ElevenLabs
// attribution on the same helper, so the credit and the audio always agree.
const naturalVoiceAvailable = hasNaturalVoice(locale);
---

<div class="read-aloud">
  <button
    id="read-aloud-toggle"
    class="read-aloud-toggle"
    type="button"
    hidden
    aria-pressed="false"
  >
    <span aria-hidden="true">🔊</span>
    <span class="read-aloud__label">{t.readAloud.deviceIdleLabel}</span>
  </button>
  {
    naturalVoiceAvailable && (
      <Fragment>
        <button
          id="read-aloud-natural-toggle"
          class="read-aloud-toggle"
          type="button"
          hidden
          aria-pressed="false"
        >
          <span aria-hidden="true">🎙️</span>
          <span class="read-aloud-natural__label">{t.readAloud.naturalIdleLabel}</span>
        </button>
        <audio id="read-aloud-natural-audio" hidden preload="none" src="/audio/main.mp3" />
      </Fragment>
    )
  }
  <p id="read-aloud-status" class="visually-hidden" role="status" aria-live="polite"></p>
</div>

<script>
  import "../scripts/read-aloud.ts";
</script>

<style lang="scss">
  @use "@styles/abstracts" as *;

  .read-aloud {
    display: flex;
    flex-wrap: wrap;
    gap: space("2");
    margin-top: space("3");
  }

  .read-aloud-toggle {
    display: inline-flex;
    align-items: center;
    gap: space("1");
    padding: space("1") space("2");
    background: transparent;
    border: 1px solid color("hairline");
    border-radius: radius("sm");
    color: color("text-primary");
    cursor: pointer;

    // These were the only interactive controls on the site with no hover
    // treatment at all — the theme toggle, the language trigger, the hero CTA,
    // and the error pages' back-home link all have one. That gap mattered most
    // here: this is the read-aloud control, so the people most likely to reach
    // for it are the people least well served by a button that acknowledges
    // nothing on hover.
    // One transition declaration rather than a second block, for the reason
    // ErrorPage.astro's `.back-home` documents: a later `transition` replaces
    // an earlier one outright instead of adding to it.
    @include motion-safe {
      transition:
        background-color duration("slow") ease("in-out"),
        border-color duration("slow") ease("in-out");
    }

    // Border and surface only, deliberately no lift. src/scripts/motion.ts
    // explains why a per-item translate is wrong in a row of siblings: the
    // hovered one reads as falling out of alignment with its neighbour. These
    // two toggles sit side by side, so the same reasoning applies.
    &:hover {
      background: color("surface");
      border-color: color("accent-primary");
    }
  }
</style>
