---
/** Renders the honesty-over-hype disclaimer note shown near the page footer. */
import styles from "./Disclaimer.module.scss";
import { m } from "../paraglide/messages.js";
---

<aside class={styles.disclaimer} role="note" aria-label={m.disclaimer_aria_label()}>
  <div class="wrap">
    <p class={styles.text}>{m.disclaimer_text()}</p>
  </div>
</aside>
