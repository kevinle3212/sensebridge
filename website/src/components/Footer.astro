---
/**
 * Renders the site footer: tagline, GitHub link, "not yet available" notice,
 * and — only on routes that actually ship the pre-rendered narration — the
 * ElevenLabs attribution that audio requires.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { hasNaturalVoice } from "../data/natural-voice";
import { POWERED_BY } from "../data/powered-by";
import { useTranslations, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const t = useTranslations(locale);

// `public/audio/main.mp3` is generated on ElevenLabs' free plan, which grants
// no commercial licence and requires published content to credit
// `elevenlabs.io`. That obligation attaches to the audio itself and survives a
// later upgrade, so this credit stays as long as free-plan audio ships. It
// lives in the footer rather than beside the player deliberately: the player
// sits inside `<main id="main">`, which is the exact text
// `scripts/generate-audio.js` hashes, so putting the credit there would
// invalidate the narration and force a regeneration (~4,400 of the free
// plan's 10,000 monthly credits) every time this line changed.
// See `website/README.md` → "Cost, quota, and licensing".
const showVoiceCredit = hasNaturalVoice(locale);

// Gated on the same variable as the integration in astro.config.mjs and the
// consent switch in MonitoringConsent.astro, so this credit can never claim
// Sentry exists in a build that doesn't carry it.
const isMonitoringConfigured = Boolean(import.meta.env.PUBLIC_SENTRY_DSN?.trim());
---

<footer class="site-footer">
  <div class="wrap">
    <img
      class="maker-photo"
      src="/images/team/kevin-le.jpg"
      alt={t.footer.makerPhotoAlt}
      width="88"
      height="88"
      loading="lazy"
      decoding="async"
    />
    <div class="footer-copy">
      <p>{t.footer.tagline}</p>
      <p>
        <a href="https://github.com/kevinle3212/sensebridge">{t.footer.githubLink}</a>
      </p>
      {
        /* On every page, not only the home page: the consent switch lives at
          the other end of this link, and a preference you can only reach from
          one route is not one you can withdraw as easily as you gave it.
          `getRelativeLocaleUrl` keeps a reader inside their own locale. */
      }
      <p>
        <a href={getRelativeLocaleUrl(locale, "/privacy")}>{t.footer.privacyLink}</a>
      </p>
      {
        /* Also on every page, and for a requirement rather than a courtesy:
          the European Accessibility Act and EN 301 549 expect the accessibility
          statement to be reachable from anywhere in the service, including from
          the page where a reader has just hit the barrier they want to report. */
      }
      <p>
        <a href={getRelativeLocaleUrl(locale, "/accessibility")}>
          {t.footer.accessibilityLink}
        </a>
      </p>
      <p>{t.footer.notAvailable}</p>
      {
        showVoiceCredit && (
          <p class="voice-credit">
            {/* ElevenLabs' own mark (the two bars from their icon.svg), drawn
                in `currentColor` inside our badge rather than shipping their
                white rounded-square lockup, so it sits in the site's palette
                and works in both themes. Decorative: the sentence beside it
                already names elevenlabs.io, which is what the licence
                requires, so announcing the logo too would just be noise. */}
            <span class="voice-credit-badge" aria-hidden="true">
              {/* viewBox cropped to the bars' own bounding box (their
                  icon.svg pads them inside a 500×500 square). At badge size
                  the untrimmed padding rendered each 43-unit bar under a
                  pixel wide, so the mark read as a smudge. */}
              <svg viewBox="186 145 128 210" focusable="false">
                <path d="M314 355H271V145H314V355Z" />
                <path d="M229 355H186V145H229V355Z" />
              </svg>
            </span>
            {t.footer.voiceCredit}
          </p>
        )
      }
      {
        /* Flat glyphs, not circled badges: the circle is reserved for the
          ElevenLabs credit so the one attribution the licence actually
          compels stays visually distinct from these voluntary ones. */
      }
      <p class="powered-by">
        <span class="powered-by-label">{t.footer.poweredBy}</span>
        {
          POWERED_BY.map((entry) => (
            <span class="powered-by-item">
              {entry.mark && (
                <svg
                  class="powered-by-mark"
                  viewBox={entry.mark.viewBox}
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={entry.mark.d} />
                </svg>
              )}
              {entry.name}
            </span>
          ))
        }
      </p>
      {
        // Voluntary credit, so it gets the same flat-glyph treatment as the
        // Powered By row rather than the circular badge reserved for the
        // ElevenLabs attribution the free-plan licence actually compels.
        // Gated on `isMonitoringConfigured`: a build with no DSN carries no
        // Sentry integration at all, and this line would be false in it.
        isMonitoringConfigured && (
          <p class="monitoring-credit">
            <span class="powered-by-item">
              <svg class="powered-by-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M13.91 2.505c-.873-1.448-2.972-1.448-3.844 0L6.904 7.92a15.478 15.478 0 0 1 8.53 12.811h-2.221A13.301 13.301 0 0 0 5.784 9.814l-2.926 5.06a7.65 7.65 0 0 1 4.435 5.848H2.194a.365.365 0 0 1-.298-.534l1.413-2.402a5.16 5.16 0 0 0-1.614-.913L.296 19.275a2.182 2.182 0 0 0 .812 2.999 2.24 2.24 0 0 0 1.086.288h6.983a9.322 9.322 0 0 0-3.845-8.318l1.11-1.922a11.47 11.47 0 0 1 4.95 10.24h5.915a17.242 17.242 0 0 0-7.885-15.28l2.244-3.845a.37.37 0 0 1 .504-.13c.255.14 9.75 16.708 9.928 16.9a.365.365 0 0 1-.327.543h-2.287c.029.612.029 1.223 0 1.831h2.297a2.206 2.206 0 0 0 1.922-3.31z" />
              </svg>
              {t.footer.monitoringCredit}
            </span>
          </p>
        )
      }
    </div>
  </div>
</footer>

<style lang="scss">
  @use "@styles/abstracts" as *;

  .site-footer {
    @include type-small;
    padding-block: space("3");
    border-top: 1px solid color("hairline");
    color: color("text-secondary");
  }

  .site-footer .wrap {
    display: flex;
    align-items: center;
    gap: space("2");
  }

  // Small and restrained on purpose — a credit, not a hero photo. Hairline
  // border matches the site's other bordered surfaces (cards, the theme
  // toggle) rather than introducing a new visual treatment.
  .maker-photo {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    object-fit: cover;
    border: 1px solid color("hairline");
    border-radius: 50%;
  }

  .footer-copy p + p {
    margin-top: space("1");
  }

  .voice-credit {
    display: flex;
    align-items: center;
    gap: space("1");
  }

  // Wraps rather than scrolls: six names plus a label overflow a phone width,
  // and the row is a credit nobody needs to read in one line.
  .powered-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: space("1");
    margin-top: space("2");
  }

  .powered-by-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  // Monochrome in `currentColor` so both themes work from one asset — see
  // src/data/powered-by.ts for why colour was not an option here.
  .powered-by-mark {
    width: 0.875rem;
    height: 0.875rem;
    flex: none;
    fill: currentcolor;
  }

  // Same circular-badge vocabulary as SignalBridge's replay control (44px
  // circle, hairline border, mark in `currentColor`) at roughly half scale,
  // because this one is a passive credit rather than a 44px touch target —
  // the pointer-target minimum does not apply to something you cannot press.
  .voice-credit-badge {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.375rem;
    height: 1.375rem;
    background: color("surface");
    border: 1px solid color("hairline");
    border-radius: 50%;
  }

  // Sized by height only, with width following the cropped viewBox's 128:210
  // aspect — forcing a square here would stretch the bars. Roughly 45% of the
  // circle, a little more generous than the replay icon's 36%, because two
  // thin bars need the extra size to still read as a mark.
  .voice-credit-badge svg {
    height: 0.625rem;
    width: auto;
    fill: currentcolor;
  }

  // Below this width the photo-beside-text row gets cramped against the
  // longest line (the "not yet available" notice) — stack instead of
  // shrinking the photo further.
  @media (width < 26rem) {
    .site-footer .wrap {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
