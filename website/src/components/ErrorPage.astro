---
/**
 * Shared layout for every HTTP status page: the cow-in-a-hole illustration
 * plus a status label, heading, body, and a way back home.
 *
 * The illustration is `aria-hidden` (CowHoleIllustration.astro) — the label,
 * heading, and body below carry the same information for anyone not seeing it,
 * so nothing is lost without it.
 *
 * Copy resolution: the three codes a visitor can actually land on (400, 404,
 * 500) have hand-written copy; every other registered code falls back to copy
 * written for its status class. See src/data/http-status.ts.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import CowHoleIllustration from "./CowHoleIllustration.astro";
import { m } from "../paraglide/messages.js";
import type { Locale } from "../paraglide/runtime.js";
import { findStatus, statusClass, type StatusClass } from "../data/http-status";

interface Props {
  /** The HTTP status code this page represents. */
  code: number;
  locale?: Locale;
}

const { code, locale = (Astro.currentLocale ?? "en") as Locale } = Astro.props;

const phrase = findStatus(code)?.phrase ?? "";

// Hand-written copy wins where it exists; otherwise the code falls back to its
// class. Keyed by code rather than by a chain of conditionals so adding another
// bespoke entry is a one-line change.
const bespokeCopy: Partial<Record<number, { heading: string; body: string }>> = {
  400: {
    heading: m.error_pages_bad_request_heading({}, { locale }),
    body: m.error_pages_bad_request_body({}, { locale }),
  },
  404: {
    heading: m.error_pages_not_found_heading({}, { locale }),
    body: m.error_pages_not_found_body({}, { locale }),
  },
  500: {
    heading: m.error_pages_server_error_heading({}, { locale }),
    body: m.error_pages_server_error_body({}, { locale }),
  },
};
const classCopy: Record<StatusClass, { heading: string; body: string }> = {
  informational: {
    heading: m.error_pages_class_informational_heading({}, { locale }),
    body: m.error_pages_class_informational_body({}, { locale }),
  },
  success: {
    heading: m.error_pages_class_success_heading({}, { locale }),
    body: m.error_pages_class_success_body({}, { locale }),
  },
  redirect: {
    heading: m.error_pages_class_redirect_heading({}, { locale }),
    body: m.error_pages_class_redirect_body({}, { locale }),
  },
  client: {
    heading: m.error_pages_class_client_heading({}, { locale }),
    body: m.error_pages_class_client_body({}, { locale }),
  },
  server: {
    heading: m.error_pages_class_server_heading({}, { locale }),
    body: m.error_pages_class_server_body({}, { locale }),
  },
};
const copy = bespokeCopy[code] ?? classCopy[statusClass(code)];

const label = m.error_pages_status_label({ code, phrase }, { locale });
---

<BaseLayout title={label} noindex ambient={false} pageLoader={false}>
  <section class="error-page">
    <div class="wrap">
      <CowHoleIllustration code={code} />
      <p class="status-label">{label}</p>
      <h1>{copy.heading}</h1>
      <p class="body">{copy.body}</p>
      <a class="back-home" href={getRelativeLocaleUrl(locale, "/")}
        >{m.error_pages_back_home({}, { locale })}</a
      >
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use "@styles/abstracts" as *;

  .error-page {
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding-block: space("5");
  }

  .error-page .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .status-label {
    margin-top: space("3");
    color: color("text-secondary");

    @include type-label;
  }

  .error-page h1 {
    margin-top: space("1");
    max-width: 20ch;
    text-wrap: balance;

    @include type-h2;
  }

  .body {
    margin-top: space("2");
    max-width: 46ch;
    color: color("text-secondary");
    text-wrap: pretty;
  }

  .back-home {
    display: inline-block;
    margin-top: space("3");
    padding: 0.75rem space("3");
    border: 1px solid color("accent-primary");
    border-radius: radius("md");
    color: color("text-primary");
    text-decoration: none;

    // One transition declaration rather than @include theme-transition plus a
    // second block: the later `transition` would replace the mixin's outright,
    // silently dropping the color/border cross-fade it exists to provide.
    @include motion-safe {
      transition:
        background-color duration("slow") ease("in-out"),
        color duration("slow") ease("in-out"),
        border-color duration("slow") ease("in-out"),
        transform duration("base") ease("standard");
    }

    &:hover {
      background: color("surface");

      @include motion-safe {
        transform: translateY(-2px);
      }
    }
  }
</style>
