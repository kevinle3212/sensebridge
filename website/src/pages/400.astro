---
/**
 * 400-series error page. Not locale-routed like 404.astro/es/404.astro/
 * vi/404.astro: a raw HTTP-level 4xx from the web server (see
 * docker/nginx.conf.template's error_page directives) has no request path
 * to read a locale prefix from, so this only ever renders in English.
 */
import ErrorPage from "../components/ErrorPage.astro";
---

<ErrorPage kind="400" locale="en" />
