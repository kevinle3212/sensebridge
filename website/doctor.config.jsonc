{
  "$schema": "https://react.doctor/schema/config.json",
  // Only suppressions live here, plus one opt-in rule below. No shipped
  // rule is weakened: every security, bug, performance, and accessibility
  // rule runs at its default severity, and CI blocks on warnings (see
  // .github/workflows/react-doctor.yml).
  "rules": {
    // The one Security-category rule that ships off by default (opt-in,
    // per `react-doctor rules explain react-doctor/no-danger`) — everything
    // else in that category is on. Verified 2026-08-04: no
    // `dangerouslySetInnerHTML`/`set:html` anywhere under website/src (see
    // StructuredData.tsx's own comment on why it avoids that sink), so this
    // adds defense-in-depth against a future raw-HTML sink without
    // producing any current finding.
    "react-doctor/no-danger": "error"
  }
  // The `ignore.overrides` block that used to sit here (deslop/unused-file,
  // deslop/unused-export, rules-of-hooks false positives on src/layouts/**
  // and .astro `useTranslations` calls) was removed 2026-08-06: verified by
  // moving this file aside and running `npm run doctor` — 0.9.2 reports zero
  // findings with no config at all, so upstream fixed the layouts blind spot
  // between 0.9.1 and 0.9.2. Re-add only if a real finding reappears.
}
